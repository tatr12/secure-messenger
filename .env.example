POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=messenger_db

DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/messenger_db
REDIS_URL=redis://redis:6379/0

SMTP_HOST=mailpit
SMTP_PORT=1025
PUBLIC_BASE_URL=https://messenger.example.com

# Absolute paths outside this repository. Never commit the certificate private key.
TLS_CERT_PATH=/absolute/path/to/fullchain.pem
TLS_KEY_PATH=/absolute/path/to/privkey.pem

# Replace with the public HTTPS origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
